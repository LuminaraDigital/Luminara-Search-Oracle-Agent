{
  "name": "luminara-suite",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p worker && node scripts/check-honesty-gates.mjs",
    "lint": "eslint . --max-warnings 400",
    "lint:ci": "eslint . --max-warnings 400",
    "test:coverage": "vitest run --coverage",
    "honesty:baseline": "node scripts/check-honesty-gates.mjs --write-baseline",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy --env production",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:prod": "npm run deploy",
    "db:migrate": "wrangler d1 migrations apply luminara-users --remote",
    "db:migrate:staging": "wrangler d1 migrations apply luminara-users-staging --remote --env staging",
    "db:migrate:local": "wrangler d1 migrations apply luminara-users --local",
    "env:validate": "node scripts/validate-env.mjs",
    "smoke": "node scripts/smoke-check.mjs",
    "smoke:staging": "node scripts/smoke-check.mjs --staging",
    "smoke:prod": "node scripts/smoke-check.mjs --prod",
    "tg:setup": "node scripts/telegram-setup.mjs",
    "keys:generate": "node scripts/generate-license-keys.mjs",
    "keys:seed-vault": "node scripts/seed-license-vault.mjs",
    "keys:seed-vault:apply": "node scripts/seed-license-vault.mjs --apply",
    "keys:revoke": "node scripts/revoke-license-keys.mjs",
    "test": "vitest run",
    "evals": "node evals/run-evals.mjs",
    "test:watch": "vitest",
    "cli": "node --experimental-strip-types services/harness/standaloneCli.ts",
    "crawler": "node crawler/server.mjs",
    "playbooks": "node scripts/build-playbooks.mjs",
    "prebuild": "node scripts/build-playbooks.mjs",
    "pretest": "node scripts/build-playbooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "secrets:check": "node scripts/check-secrets.mjs --all",
    "secrets:check:staged": "node scripts/check-secrets.mjs --staged",
    "secrets:sync-hosted": "node scripts/sync-hosted-secrets.mjs",
    "secrets:sync-hosted:apply": "node scripts/sync-hosted-secrets.mjs --apply",
    "desktop:dev": "node scripts/desktop-dev-start.mjs",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir --config electron-builder.yml",
    "desktop:dist:win": "electron-builder --win --config electron-builder.yml",
    "desktop:mirror-r2": "node scripts/mirror-desktop-r2.mjs",
    "desktop:check-signing": "node scripts/check-desktop-signing.mjs",
    "grounding:prompt": "node --experimental-strip-types services/grounding/cli.ts --show-system-prompt",
    "grounding:seed": "node --experimental-strip-types services/grounding/cli.ts --seed",
    "grounding:fetch": "node --experimental-strip-types services/grounding/cli.ts --fetch",
    "grounding:gate": "node --experimental-strip-types services/grounding/cli.ts",
    "grounding:score": "node --experimental-strip-types services/grounding/cli.ts"
  },
  "dependencies": {
    "@formepdf/core": "^0.20.1",
    "@formepdf/react": "^0.20.1",
    "@google/genai": "1.34.0",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui-react": "^3.0.2",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "firebase": "^12.18.0",
    "jose": "^6.2.12",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@eslint/js": "^9.39.5",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.5",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.129.0"
  },
  "description": "Open-source AI search visibility suite: SEO, AEO and GEO audits grounded in live search results, runs on your own Groq / NVIDIA NIM / Ollama keys. Web + Telegram Mini App + Windows desktop on Cloudflare.",
  "author": "Luminara Digital",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminaraDigital/Luminara-Search-Oracle-Agent.git"
  },
  "homepage": "https://luminarasuite.com"
}
