# Luminara Search Oracle Agent - Environment Configuration Template
#
# WARNING: any VITE_ variable is compiled into the public JS bundle and can be read by anyone who
# opens the site. The VITE_*_API_KEY entries below are for `npm run dev` on your own machine only.
# Production builds (`vite build`) blank every VITE_ variable whose name contains KEY/SECRET/TOKEN/
# PASSWORD and refuse to emit a bundle that contains a key-shaped string, so real keys belong in
# the Cloudflare Worker (`wrangler secret put`, see .dev.vars.example) or in the in-app Settings.

# 1. Tavily Search API Key (Autonomous Search & SERP Grounding)
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# 2. FireCrawl API Key (Deep Web Crawling, Markdown Scraping & Site Diagnostics)
VITE_FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# 3. Tinker API Key (Agent Tool Runtime & Execution)
VITE_TINKER_API_KEY=your_tinker_api_key_here

# 4. Browserbase API Key (Cloud Headless Browser Sessions & Interactive Automation)
VITE_BROWSERBASE_API_KEY=your_browserbase_api_key_here

# 5. Groq Primary API Key (Ultra-Fast LLM Inference: Llama-3.3-70B, DeepSeek-R1)
VITE_GROQ_API_KEY=your_groq_api_key_here

# 6. Groq Fallback API Key (High-Availability Failover)
VITE_GROQ_API_KEY_FALLBACK=your_secondary_groq_api_key_here

# 7. Exa.ai API Key (Neural Semantic Web Search & Competitor Discovery)
VITE_EXA_API_KEY=your_exa_api_key_here

# 8. Fal.ai API Key (Generative AI Models & Multimodal Image Processing)
VITE_FAL_KEY=your_fal_api_key_here

# 9. NVIDIA NIM API Key & Org ID (Enterprise AI Inference: Llama-3.1-70B, DeepSeek-R1)
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_ORG_ID=your_nvidia_org_id_here

# 10. Ollama Cloud / Remote API Key (Open Model Gateway)
VITE_OLLAMA_API_KEY=your_ollama_api_key_here

# Optional: Google Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Local dev against the Cloudflare Worker (run `npm run cf:dev` in another terminal):
# VITE_API_BASE=http://localhost:8787

# ---- Firebase Auth (signup / signin for hosted keys on Cloudflare) ---------------------------
# Public web config from Firebase Console > Project settings > Your apps > Web app.
# Also set FIREBASE_PROJECT_ID on the Worker (wrangler.jsonc vars or .dev.vars) to the same projectId.
# Enable Email/Password and (optional) Google under Authentication > Sign-in method.
# Add luminarasuite.com and localhost to Authorized domains.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ---- Self-hosted helpers: Writing check (LanguageTool) and Results tracking (Umami) ----------
# Start them with `docker compose up -d` (see README "Writing check and results tracking").

# Used only by docker compose to boot the tracking dashboard. Any long random string; never shipped.
# UMAMI_APP_SECRET=change-me-to-a-long-random-string

# Dev only, read by the Vite dev server proxy (server side, no VITE_ prefix, never bundled).
# The browser calls /api/sidecars/<id>/... and Vite forwards to these targets, adding the key.
# LANGUAGETOOL_URL=http://localhost:8010
# UMAMI_URL=http://localhost:3002
# UMAMI_API_KEY=

# Optional browser-side direct URLs. WARNING: VITE_ values ship to every visitor, including the
# key. Only use them for a private local build; prefer the Worker relay for anything public.
# VITE_LANGUAGETOOL_URL=http://localhost:8010
# VITE_UMAMI_URL=http://localhost:3002
# VITE_UMAMI_API_KEY=
