{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luminara-search-oracle-agent",
  "account_id": "2373013c66331e9660e47ffa3ae40f5c",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 24/7 Cloudflare Drift Sentinel Cron Trigger (runs daily at 08:00 UTC)
  "triggers": {
    "crons": ["0 8 * * *"]
  },

  // The Vite build output is served as static assets. Every request goes through the Worker first
  // so the HTML shell and API responses carry security headers (CSP, HSTS, nosniff, ...).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Custom domain: luminarasuite.com (Cloudflare Zone ID: 495e6808c92887d826486bde8550f194).
  // Wrangler creates the DNS records automatically when deployed.
  "routes": [
    { "pattern": "luminarasuite.com", "custom_domain": true },
    { "pattern": "www.luminarasuite.com", "custom_domain": true }
  ],

  // Subscriptions and per-user state. Create with: npx wrangler kv namespace create LUMINARA_KV
  // then paste the returned id below.
  "kv_namespaces": [
    { "binding": "LUMINARA_KV", "id": "00d331adea604a70945fb1651b7968b3" }
  ],

  // D1: users, Telegram↔Firebase account linking, and per-account workspace blobs.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luminara-users",
      "database_id": "e828e0b0-491d-4d0b-b5ea-bd4bdd6c7b8a"
    }
  ],

  // Windows installer mirror (optional until R2 is enabled on the account).
  // 1) Dashboard: Storage & databases → R2 → complete checkout / Enable R2
  // 2) npx wrangler r2 bucket create luminara-desktop-releases
  // 3) Uncomment the block below, then npm run deploy
  // "r2_buckets": [
  //   { "binding": "DESKTOP_RELEASES", "bucket_name": "luminara-desktop-releases" }
  // ],

  // Optional global rate limiting (Cloudflare Rate Limiting API). The Worker already applies a
  // best-effort per-isolate limit; uncomment to enforce a single limit across all edge locations.
  // "unsafe": {
  //   "bindings": [
  //     { "name": "API_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  //   ]
  // },

  // Non-secret config. Secrets are set with `npx wrangler secret put NAME`:
  //   BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET (required for the bot webhook), GROQ_API_KEY, GEMINI_API_KEY,
  //   OPENROUTER_API_KEY, TAVILY_API_KEY, FIRECRAWL_API_KEY, EXA_API_KEY, NVIDIA_API_KEY, NVIDIA_ORG_ID, OLLAMA_API_KEY,
  //   TON_API_KEY (Toncenter), UMAMI_API_KEY (or UMAMI_USERNAME + UMAMI_PASSWORD).
  // Non-secret TON merchant wallet (safe in vars): TON_RECEIVING_ADDRESS
  "vars": {
    "ENVIRONMENT": "production",
    "WEBAPP_URL": "https://luminarasuite.com/",
    "ALLOWED_ORIGINS": "https://luminarasuite.com,https://www.luminarasuite.com",
    // Hosted keys are gated: Groq Cloud LPU is free (subject to daily limit).
    // NVIDIA NIM, Sovereign Ollama, and OpenRouter require an active paid subscription.
    // Users can always bring their own API keys in Settings (BYOK never paywalled).
    "REQUIRE_TG_AUTH": "true",
    "REQUIRE_SUBSCRIPTION": "false",
    "FREE_DAILY_LIMIT": "25",
    // Sovereign Ollama Base URL (optional, defaults to https://ollama.com if unset)
    "OLLAMA_BASE_URL": "",
    // Firebase Auth project id (same as VITE_FIREBASE_PROJECT_ID). Empty disables Firebase token checks.
    "FIREBASE_PROJECT_ID": "luminara-suite",
    // Self-hosted helpers (README "Writing check and results tracking"). URLs are public config;
    // leave empty to disable. Credentials go in via `wrangler secret put`, never here.
    "LANGUAGETOOL_URL": "",
    "UMAMI_URL": "",
    "DESKTOP_GITHUB_REPO": "LuminaraDigital/Luminara-Search-Oracle-Agent"
  },

  // Multi-Environment Isolation Safeguards
  "env": {
    "staging": {
      "name": "luminara-search-oracle-agent-staging",
      "routes": [
        { "pattern": "staging.luminarasuite.com", "custom_domain": true }
      ],
      "kv_namespaces": [
        { "binding": "LUMINARA_KV", "id": "1898b8c88b1048b38be720bcf6c5a91c" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "luminara-users-staging",
          "database_id": "2aeb897a-d2d4-462b-89c5-0d9efbf093fe"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "WEBAPP_URL": "https://staging.luminarasuite.com/",
        "ALLOWED_ORIGINS": "https://staging.luminarasuite.com",
        "REQUIRE_TG_AUTH": "false",
        "REQUIRE_SUBSCRIPTION": "false",
        "FREE_DAILY_LIMIT": "100",
        "FIREBASE_PROJECT_ID": "luminara-suite-staging",
        "OLLAMA_BASE_URL": "",
        "LANGUAGETOOL_URL": "",
        "UMAMI_URL": "",
        "DESKTOP_GITHUB_REPO": "LuminaraDigital/Luminara-Search-Oracle-Agent"
      }
    },
    "production": {
      "name": "luminara-search-oracle-agent",
      "routes": [
        { "pattern": "luminarasuite.com", "custom_domain": true },
        { "pattern": "www.luminarasuite.com", "custom_domain": true }
      ],
      "kv_namespaces": [
        { "binding": "LUMINARA_KV", "id": "00d331adea604a70945fb1651b7968b3" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "luminara-users",
          "database_id": "e828e0b0-491d-4d0b-b5ea-bd4bdd6c7b8a"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "WEBAPP_URL": "https://luminarasuite.com/",
        "ALLOWED_ORIGINS": "https://luminarasuite.com,https://www.luminarasuite.com",
        "REQUIRE_TG_AUTH": "true",
        "REQUIRE_SUBSCRIPTION": "false",
        "FREE_DAILY_LIMIT": "25",
        "FIREBASE_PROJECT_ID": "luminara-suite",
        "OLLAMA_BASE_URL": "",
        "LANGUAGETOOL_URL": "",
        "UMAMI_URL": "",
        "DESKTOP_GITHUB_REPO": "LuminaraDigital/Luminara-Search-Oracle-Agent"
      }
    }
  }
}
