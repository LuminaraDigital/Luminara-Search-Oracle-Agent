#!/usr/bin/env bash
# ==============================================================================
# Luminara Archy: Standalone Command Router
# Usage: luminara <group> <action> [args] [--flags]
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! command -v node >/dev/null 2>&1; then
    echo "Error: Node.js is required to execute the Luminara CLI harness." >&2
    exit 1
fi

exec node --experimental-strip-types "$REPO_ROOT/services/harness/standaloneCli.ts" "$@"
