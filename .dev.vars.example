# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars). Production uses `wrangler secret put`.
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Dedicated admin API secret (x-admin-secret header) for /api/admin/* and /api/telegram/refund.
# Separate from TELEGRAM_WEBHOOK_SECRET; unset = admin API returns 503 (openssl rand -hex 32)
ADMIN_SECRET=
# Secret for verifying signed auth lifecycle webhooks (openssl rand -hex 32)
AUTH_WEBHOOK_SECRET=
# Same as VITE_FIREBASE_PROJECT_ID (public project id; used to verify ID tokens via Google JWKS).
FIREBASE_PROJECT_ID=luminara-suite
# Numeric project number (Messaging Sender ID). Required when REQUIRE_APP_CHECK=true.
FIREBASE_PROJECT_NUMBER=274315225068
# Keep false until App Check site key + console registration are live.
REQUIRE_APP_CHECK=false
# Same public value as VITE_FIREBASE_API_KEY (Identity Toolkit password-reset from the Worker).
FIREBASE_WEB_API_KEY=
# Soft daily cap on outbound password-reset emails (default 200 in wrangler vars).
OUTBOUND_EMAIL_DAILY_LIMIT=200
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GEMINI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
NVIDIA_API_KEY=
NVIDIA_ORG_ID=
OLLAMA_API_KEY=
# Self-hosted helpers (see README "Writing check and results tracking"). URLs are plain config;
# the key and password are secrets. Umami: set UMAMI_API_KEY, or UMAMI_USERNAME + UMAMI_PASSWORD.
LANGUAGETOOL_URL=
UMAMI_URL=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
# TON dual-rail (web / desktop). Merchant wallet + Toncenter API key (network-specific).
TON_RECEIVING_ADDRESS=
# The address the owner has confirmed, in their own wallet app, to be theirs. Must equal TON_RECEIVING_ADDRESS.
# Empty or different keeps TON checkout closed.
TON_CONFIRMED_ADDRESS=
TON_API_KEY=
# Chain network gate (must match merchant address + API hosts)
CHAIN_NETWORK=mainnet
CHAIN_TON_API_BASE=https://toncenter.com/api/v3
CHAIN_TON_API_FALLBACK_BASE=https://tonapi.io
CHAIN_XDC_RPC_URL=https://erpc.xinfin.network
PROOF_ANCHOR_ENABLED=false
PROOF_XDC_ENABLED=false
# SMB Launchpad (spec 0015). Unset = on in local dev only; staging/prod need true. Explicit false always disables.
# LAUNCHPAD_ENABLED=true
# Trust Network (docs/plans/trust-network-additive-plan.md). Unset = on in local dev only.
# TRUST_RECEIPTS_ENABLED=true
# DOMAIN_VERIFY_ENABLED=true
# Secret: Ed25519 private JWK from `npm run keys:receipt` (wrangler secret put RECEIPT_SIGNING_KEY).
# RECEIPT_SIGNING_KEY=
# RECEIPT_RETIRED_PUBLIC_KEYS=[]
LAUNCHPAD_MAINNET_ENABLED=false
# Testnet-only: skip on-chain deployment check at registration while no factory is deployed
# LAUNCHPAD_SKIP_CHAIN_VERIFY=true
