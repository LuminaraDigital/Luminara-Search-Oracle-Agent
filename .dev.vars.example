# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars). Production uses `wrangler secret put`.
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Same as VITE_FIREBASE_PROJECT_ID (public project id; used to verify ID tokens via Google JWKS).
FIREBASE_PROJECT_ID=
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GEMINI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
NVIDIA_API_KEY=
NVIDIA_ORG_ID=
OLLAMA_API_KEY=
# Self-hosted helpers (see README "Writing check and results tracking"). URLs are plain config;
# the key and password are secrets. Umami: set UMAMI_API_KEY, or UMAMI_USERNAME + UMAMI_PASSWORD.
LANGUAGETOOL_URL=
UMAMI_URL=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
