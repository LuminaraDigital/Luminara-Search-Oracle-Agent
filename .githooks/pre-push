#!/bin/sh
# Luminara Suite - Pre-Push Branch Safeguard & Automated Smoke Checks
# Enforces branch hierarchy: feature/* -> staging (pre-production validation) -> main / prod

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 1. Block direct unvalidated pushes to main / prod
if [ "$current_branch" = "main" ] || [ "$current_branch" = "prod" ]; then
  if [ "$ALLOW_DIRECT_PROD_PUSH" != "1" ] && [ -z "$CI" ]; then
    echo "\033[0;31m[Branch Safeguard Error] A direct push to '$current_branch' is refused.\033[0m"
    echo "Open a pull request instead: feature/* -> staging, then staging -> main."
    exit 1
  fi
fi

# Every check below runs on the working tree that is being pushed, with that tree's own
# scripts. This hook directory can be shared by several worktrees (an absolute core.hooksPath),
# so nothing may depend on which checkout this file happens to be in.
top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$top" ] || [ ! -d "$top" ]; then
  echo "[Pre-Push] Could not find the top level of the working tree being pushed."
  exit 1
fi
cd "$top" || exit 1

# 2. Block pushes when the worktree still contains secret-shaped material
echo "[Pre-Push] 1/4 Checking for secret leaks..."
node "$top/scripts/check-secrets.mjs" --all || exit 1

# 3. Typecheck validation
echo "[Pre-Push] 2/4 Validating TypeScript types..."
npm run typecheck || exit 1

# 4. Ratchets: no file may get worse than it is on staging.
# This hook is shared by every worktree, and a branch cut before the ratchets has no script.
if [ -f "$top/scripts/check-ratchets.mjs" ]; then
  echo "[Pre-Push] 3/4 Checking ratchets against staging..."
  node "$top/scripts/check-ratchets.mjs" || exit 1
fi

# 5. Automated smoke checks
echo "[Pre-Push] 4/4 Running automated test suite & smoke checks..."
npm test || exit 1
node "$top/scripts/smoke-check.mjs" --dry-run || exit 1

echo "\033[0;32m[Pre-Push] All branch safeguards and smoke checks passed!\033[0m"
exit 0
