# Luminara Search Oracle Agent - Production Environment Configuration Template
# Used for building and verifying production deployments.
#
# Production builds strip out VITE_*_KEY variables to protect credentials.
# Real provider keys and production bot tokens are stored securely in Cloudflare Secrets:
#   npx wrangler secret put GROQ_API_KEY --env production
#   npx wrangler secret put BOT_TOKEN --env production

# Production Worker API Base
VITE_API_BASE=https://luminarasuite.com

# Production Firebase Auth Project
VITE_FIREBASE_API_KEY=AIzaSyDPX87WXZHFQu7XuCJyHhDoVcyY1-z8bxc
VITE_FIREBASE_AUTH_DOMAIN=luminara-suite.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=luminara-suite
VITE_FIREBASE_APP_ID=1:274315225068:web:092053650dfce884f482c9
VITE_FIREBASE_MESSAGING_SENDER_ID=274315225068
VITE_FIREBASE_STORAGE_BUCKET=luminara-suite.firebasestorage.app
VITE_FIREBASE_MEASUREMENT_ID=G-L5F6WZNMGZ
# Public reCAPTCHA v3 site key for App Check (required before REQUIRE_APP_CHECK=true)
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# Local only (never ship): VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# Worker vars (also set in wrangler.jsonc). Budget hard stops: off | soft | hard.
# Soft until soft-alert invoice validation (docs/plans/suite-10x-production-ship.md).
# BUDGET_ENFORCEMENT=soft

# Worker chain gate (also set in wrangler.jsonc env.production.vars)
# CHAIN_NETWORK=mainnet
# CHAIN_TON_API_BASE=https://toncenter.com/api/v3
# CHAIN_TON_API_FALLBACK_BASE=https://tonapi.io
# CHAIN_XDC_RPC_URL=https://erpc.xinfin.network
# PROOF_ANCHOR_ENABLED=false
# PROOF_XDC_ENABLED=false
# TON_API_KEY via: npx wrangler secret put TON_API_KEY --env production
