# Luminara Search Oracle Agent - Staging Environment Configuration Template
# Use this configuration for staging / pre-production validation.
#
# IMPORTANT: Staging must connect to isolated sandbox API keys and staging Firebase/Cloudflare resources
# to prevent test data pollution in production data.

# 1. Staging Worker API Base (Cloudflare Staging Worker)
VITE_API_BASE=https://staging.luminarasuite.com

# 2. Staging Firebase Auth Project (Isolated Sandbox)
VITE_FIREBASE_API_KEY=AIzaSyD_STAGING_SANDBOX_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=luminara-suite-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=luminara-suite-staging
VITE_FIREBASE_APP_ID=1:000000000000:web:staging000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_STORAGE_BUCKET=luminara-suite-staging.firebasestorage.app

# 3. Optional Sandbox Provider Keys (for local staging builds only; real keys go in Cloudflare Worker via wrangler secret put --env staging)
VITE_GROQ_API_KEY=
VITE_TAVILY_API_KEY=
VITE_FIRECRAWL_API_KEY=
VITE_EXA_API_KEY=
VITE_NVIDIA_API_KEY=
VITE_OPENROUTER_API_KEY=

# Worker chain gate (also set in wrangler.jsonc env.staging.vars)
# Replace TON_RECEIVING_ADDRESS with a funded testnet kQ/0Q wallet before soak.
# CHAIN_NETWORK=testnet
# CHAIN_TON_API_BASE=https://testnet.toncenter.com/api/v3
# CHAIN_TON_API_FALLBACK_BASE=https://testnet.tonapi.io
# CHAIN_XDC_RPC_URL=https://rpc.apothem.network
# PROOF_ANCHOR_ENABLED=false
# PROOF_XDC_ENABLED=false
# SMB Launchpad: keep false until contract audit and legal sign-off (spec 0015)
# LAUNCHPAD_ENABLED=false
# Trust Network (docs/plans/trust-network-additive-plan.md). Unset = on in local dev only.
# TRUST_RECEIPTS_ENABLED=false
# DOMAIN_VERIFY_ENABLED=false
# Secret: Ed25519 private JWK from `npm run keys:receipt` (wrangler secret put RECEIPT_SIGNING_KEY).
# RECEIPT_SIGNING_KEY=
# RECEIPT_RETIRED_PUBLIC_KEYS=[]
# LAUNCHPAD_MAINNET_ENABLED=false
# Set after deploying our factory to testnet (mainnet address is committed in services/launchpad/contracts.ts)
# LAUNCHPAD_FACTORY_XDC_TESTNET=
# LAUNCHPAD_FACTORY_POLYGON_TESTNET=
# RPC endpoints with an SLA (https). Public RPCs are used if unset.
# LAUNCHPAD_RPC_XDC_TESTNET=
# LAUNCHPAD_RPC_XDC_MAINNET=
# LAUNCHPAD_RPC_POLYGON_TESTNET=
# LAUNCHPAD_RPC_POLYGON_MAINNET=
# TON_API_KEY via: npx wrangler secret put TON_API_KEY --env staging

# TON merchant address confirmation (also set in wrangler.jsonc vars).
# The address the owner has confirmed, in their own wallet app, to be theirs. Must equal TON_RECEIVING_ADDRESS.
# Empty or different keeps TON checkout closed.
# TON_CONFIRMED_ADDRESS=
# Mini App link of this environment's bot (https://t.me/<bot>/<app>). Worker: TELEGRAM_MINI_APP_URL in
# wrangler.jsonc. Web build: VITE_TELEGRAM_MINI_APP_URL, set as a variable of the GitHub "staging" environment.
# TELEGRAM_MINI_APP_URL=
# VITE_TELEGRAM_MINI_APP_URL=
# The VITE_FIREBASE_* values at the top of this file reach the deployed staging build only as variables of the
# GitHub "staging" environment. With none set there, staging shows sign-in as not configured; it never falls
# back to the production Firebase project.
